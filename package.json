{
  "name": "dsh-prompt-enhance",
  "version": "1.0.0",
  "description": "DSH side-panel prompt enhancer: clarify a rough prompt through a short Q&A (with read-only workspace context) and insert the finished prompt into the composer without creating a session.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build-check.mjs",
    "check": "npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prompt-engineering",
    "side-panel",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EstimateFaster/dsh-plugin-promotenhance.git"
  },
  "homepage": "https://github.com/EstimateFaster/dsh-plugin-promotenhance#readme",
  "bugs": {
    "url": "https://github.com/EstimateFaster/dsh-plugin-promotenhance/issues"
  },
  "author": "EstimateFaster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
